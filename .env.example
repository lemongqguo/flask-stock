# ---- Flask ----
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# 生产环境务必替换为强随机值，可用 python -c "import secrets;print(secrets.token_hex(32))" 生成
SECRET_KEY=<your-secret-key>

# ---- MySQL ----
MYSQL_HOST=192.168.50.76
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=<your-password>
MYSQL_DATABASE=uatstockdb
MYSQL_CHARSET=utf8mb4
MYSQL_MAX_CONNECTIONS=5
MYSQL_MIN_CACHED=2
MYSQL_MAX_CACHED=3

# ---- 邮件告警 ----
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=1
MAIL_USE_TLS=0
MAIL_USERNAME=<your-mail@qq.com>
MAIL_PASSWORD=<your-smtp-authorization-code>
MAIL_TIMEOUT=10
# 多个收件人用逗号分隔，必须是合法邮箱
ALARM_RECIPIENTS=<receiver1@example.com,receiver2@example.com>
ALARM_MAIL_ENABLED=1
# 同一订单同一告警类型（同一档位）的冷却秒数，默认 4 小时
ALARM_COOLDOWN_SECONDS=14400
# 每日汇总邮件的发送时间点（HH:MM，24 小时制）；开关在「账户设置 → 告警通知」
DAILY_SUMMARY_TIME=08:30

# ---- 雪球 ----
XUEQIU_TOKEN=<your-xueqiu-token>

# ---- 监控服务 ----
# 监控服务是否启用，1-启用，0-不启用
MONITOR_ENABLED=1
MONITOR_MAX_WORKERS=6
MONITOR_MAX_STOCKS=100
MONITOR_ERROR_SLEEP=5
# 非交易时段的休眠秒数，默认 5 分钟
MONITOR_OFF_HOURS_SLEEP=300
# 行情拉取节流区间（秒）
FETCH_MIN_DELAY=30
FETCH_MAX_DELAY=300

# ---- 指标监控（006 指标监控，均可用内置默认值，需要调阈值时再放开）----
IND_ENABLED=1
# 相对强弱基准，默认沪深300
IND_BENCH=SH000300
# 距 52 周最低不超过该百分比即告警
IND_LOW52W_NEAR_PCT=5.0
# 52 周回撤达到该百分比即告警
IND_DRAWDOWN_52W_PCT=35.0
# 20 日跑输基准的百分点
IND_RS20_PCT=15.0
# 5 日倍数与两道护栏（个股跌幅 ≥3%、基准跌幅 ≥0.5%）
IND_RS5_RATIO=2.5
IND_RS5_MIN_DROP_PCT=3.0
IND_RS5_MIN_BENCH_DROP_PCT=0.5
# 指标类告警冷却小时数（持续状态用 4h 会连发数日）
IND_COOLDOWN_HOURS=24
IND_BENCH_WINDOW_DAYS=40

# ---- AI 个股分析（007 AI 个股分析）----
# 总开关：默认关闭；未配置密钥时页面显示「未启用」而不是报错
AI_ENABLED=0
# OpenAI 兼容接口的 Base URL（末尾不带斜杠，/responses 或 /chat/completions 由 AI_API_STYLE 决定）
AI_API_BASE=https://api.openai.com/v1
# 默认模型 ID
AI_MODEL=
# 可选模型清单（逗号分隔），页面下拉从这里取；AI_MODEL 始终入选并排第一
# 例：AI_MODELS=qwen3.5-plus,gpt-4o-mini,deepseek-chat
AI_MODELS=
# 仅从环境变量读取：不入库、不回显、不写日志
AI_API_KEY=
# responses（OpenAI Responses API）| chat（/chat/completions，兼容多数自建网关）
AI_API_STYLE=responses
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=1200
# 月度调用上限，达限直接拒绝并提示（0 = 不限）
AI_MONTHLY_LIMIT=200
# 外部调用超时（秒），必传；推理型模型（单次输出数千 token）建议调到 120~180
AI_TIMEOUT=60

# ---- 日志 ----
LOG_LEVEL=INFO
