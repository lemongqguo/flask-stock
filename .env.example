# ============================================================================
# 配置模板（.env.example）
#
# 用法：cp .env.example .env 后填写真实值。应用启动时会读取项目根目录的 `.env`，
#       **本文件本身不会被加载**，仅作模板（供本地开发与 GitHub 参考）。
#
# ⚠️ 上传 GitHub 前必须确认：本文件**不得**包含任何真实凭据。
#    .gitignore 已排除 `.env`；如果你把真值写进了本文件，会被一起提交并永久留在 Git 历史里。
# ============================================================================

# ---- Flask ----
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# 生产环境务必替换为强随机值，可用 python -c "import secrets;print(secrets.token_hex(32))" 生成
SECRET_KEY=replace-with-your-own-64-hex-secret

# ---- MySQL ----
MYSQL_HOST=192.168.xx.xx
MYSQL_PORT=3306
MYSQL_USER=adminxxx
MYSQL_PASSWORD=YourPasswordx
MYSQL_DATABASE=xxxxx
MYSQL_CHARSET=utf8mb4
# 连接池上限：必须 >= GUNICORN_THREADS(8) + MONITOR_MAX_WORKERS(6)。
# **不要设成 5**：并发消费者有 8 个 HTTP 线程 + 6 个监控线程，池子小于它就会排队取连接，
# 一旦有连接被卡住，所有线程一起堵死（2026-10-30 假死根因）。
# 留空则由代码按并发推导（8+6+5=19）；显式设值小于推导值时启动会打 WARNING。
MYSQL_MAX_CONNECTIONS=19
MYSQL_MIN_CACHED=2
MYSQL_MAX_CACHED=10

# ---- MySQL 超时与保活（**跨机部署必配**，2026-10-30 假死修复）----
# 取连接的最长等待（秒）：超时报错，绝不再无限排队
MYSQL_POOL_WAIT_TIMEOUT=10
# 建连 / 读 / 写超时（秒）。PyMySQL 默认读写**无超时**，MySQL 不返回时线程会永久阻塞
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
# TCP keepalive：跨机访问时中间设备（NAT / 防火墙）会**静默回收**空闲连接，
# 两端都以为还连着，应用一发请求就永远等不到响应。keepalive 在空闲期主动探测保活。
MYSQL_TCP_KEEPALIVE=1
MYSQL_KEEPALIVE_IDLE=60
MYSQL_KEEPALIVE_INTERVAL=30
MYSQL_KEEPALIVE_COUNT=3

# ---- 邮件告警 ----
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=1
MAIL_USE_TLS=0
MAIL_USERNAME=xxxxx@qq.com
MAIL_PASSWORD=xxxxxxxxxx
MAIL_TIMEOUT=10
# 多个收件人用逗号分隔，必须是合法邮箱
ALARM_RECIPIENTS=xxxxx@qq.com,xxxx@qq.com
ALARM_MAIL_ENABLED=1
# 同一订单同一告警类型（同一档位）的冷却秒数，默认 3 小时
ALARM_COOLDOWN_SECONDS=10800
# 每日汇总邮件的发送时间点（HH:MM，24 小时制）；开关在「账户设置 → 告警通知」
DAILY_SUMMARY_TIME=08:30

# ---- 雪球 ----
# 浏览器登录后从 Cookie 取的 xq_a_token（含 u= 用户 id），属于**凭据**，切勿提交真值
XUEQIU_TOKEN="xq_a_token=your-token-here;u=your-user-id"

# ---- 监控服务 ----
# 监控服务是否启用，1-启用，0-不启用
MONITOR_ENABLED=1
MONITOR_MAX_WORKERS=6
MONITOR_MAX_STOCKS=100
MONITOR_ERROR_SLEEP=5
# 非交易时段的休眠秒数，默认 5 分钟
MONITOR_OFF_HOURS_SLEEP=30
# 行情拉取节流区间（秒）
FETCH_MIN_DELAY=30
FETCH_MAX_DELAY=300

# ---- 指标监控（006 指标监控，均可用内置默认值，需要调阈值时再放开）----
IND_ENABLED=1
# 相对强弱基准，默认沪深300
IND_BENCH=SH000300
# 距 52 周最低不超过该百分比即告警
IND_LOW52W_NEAR_PCT=5.0
# 52 周回撤达到该百分比即告警
IND_DRAWDOWN_52W_PCT=35.0
# 20 日跑输基准的百分点
IND_RS20_PCT=15.0
# 5 日倍数与两道护栏（个股跌幅 ≥3%、基准跌幅 ≥0.5%）
IND_RS5_RATIO=2.5
IND_RS5_MIN_DROP_PCT=3.0
IND_RS5_MIN_BENCH_DROP_PCT=0.5
# 指标类告警冷却小时数（持续状态用 4h 会连发数日）
IND_COOLDOWN_HOURS=24
IND_BENCH_WINDOW_DAYS=40

# ---- AI 个股分析（007 AI 个股分析）----
# 总开关：默认关闭；未配置密钥时页面显示「未启用」而不是报错
AI_ENABLED=1
# OpenAI 兼容接口的 Base URL（末尾不带斜杠，/responses 或 /chat/completions 由 AI_API_STYLE 决定）
AI_API_BASE=https://api.xxxxx.cn/v1
# 模型 ID  清单放 AI_MODELS、AI_MODEL 放单个默认，只写一个也可以
AI_MODEL  = qwen3.5-plus
# 可选模型清单（逗号分隔），页面下拉从这里取；AI_MODEL 始终入选并排第一
# 例：AI_MODELS=qwen3.5-plus,gpt-4o-mini,deepseek-chat
AI_MODELS = qwen3.5-plus,gpt-4o-mini,kimi-k2.5,deepseek-v4-pro,glm-5.3-flash
# 仅从环境变量读取：不入库、不回显、不写日志
AI_API_KEY=sk-xxxxxxxxx
# responses（OpenAI Responses API）| chat（/chat/completions，兼容多数自建网关）
AI_API_STYLE=responses
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=1200
# 月度调用上限，达限直接拒绝并提示（0 = 不限）
AI_MONTHLY_LIMIT=200
# 外部调用超时（秒），必传
AI_TIMEOUT=60

# ---- 市场成交额（009 市场成交额）----
# 页面「同步数据」按钮的冷却秒数（防止重复点击打爆外部数据源）
TURNOVER_SYNC_COOLDOWN=60
# 监控线程自动同步成交额（增量）：开关与间隔秒数（默认 3 小时；空库跳过，失败也计入间隔）
TURNOVER_AUTO_SYNC_ENABLED=1
TURNOVER_AUTO_SYNC_INTERVAL=10800

# ---- 日志 ----
LOG_LEVEL=INFO
